{
	"name": "aslan-ai",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "node scripts/dev-do.mjs",
		"dev:vite": "vite dev",
		"build": "vite build && node scripts/patch-worker-durable-objects.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "bun test",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply aslan-ai --local",
		"db:migrate:prod": "wrangler d1 migrations apply aslan-ai --remote",
		"db:studio": "drizzle-kit studio",
		"seed:polar": "bun run scripts/seed-polar.ts"
	},
	"devDependencies": {
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/d3-scale": "^4.0.9",
		"drizzle-kit": "^0.31.10",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.2",
		"vite": "^8.0.7"
	},
	"optionalDependencies": {
		"@rolldown/binding-linux-x64-gnu": "1.0.0-rc.15",
		"@rolldown/binding-linux-x64-musl": "1.0.0-rc.15",
		"lightningcss-linux-x64-gnu": "1.32.0",
		"lightningcss-linux-x64-musl": "1.32.0"
	},
	"dependencies": {
		"@cloudflare/workers-types": "^4.20260410.1",
		"@fontsource/ibm-plex-mono": "^5.2.7",
		"@fontsource/ibm-plex-sans": "^5.2.8",
		"@fontsource/playfair-display": "^5.2.8",
		"@fontsource/source-serif-4": "^5.2.9",
		"@mariozechner/pi-ai": "^0.66.1",
		"@polar-sh/sdk": "^0.47.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@tailwindcss/vite": "^4.2.2",
		"better-auth": "^1.6.2",
		"bits-ui": "^2.17.3",
		"drizzle-orm": "^0.45.2",
		"exa-js": "^2.11.0",
		"layerchart": "^1.0.13",
		"resend": "^6.10.0",
		"svelte-sonner": "^1.1.0",
		"tailwindcss": "^4.2.2",
		"wrangler": "^4.81.1"
	}
}
