# Database
DATABASE_URL=

# OpenRouter (AI calls via @mariozechner/pi-ai)
# Change OPENROUTER_DEFAULT_MODEL value only — no code changes needed
# Examples: anthropic/claude-sonnet-4-5  anthropic/claude-opus-4  google/gemini-2.5-pro  openai/gpt-4o
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=anthropic/claude-sonnet-4-5

# Alpaca (news + price data)
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Exa.ai (semantic web search)
EXA_API_KEY=

# Polar (payments) — populate POLAR_PRODUCT_* after running: bun run seed:polar
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_STARTER=
POLAR_PRODUCT_PRO=
POLAR_PRODUCT_POWER=

# Auth (better-auth) — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email
RESEND_API_KEY=
EMAIL_FROM_DOMAIN=

# App
PUBLIC_BASE_URL=
