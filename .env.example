# Database (drizzle-kit db:generate / db:studio against remote D1)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_API_TOKEN=
# OpenRouter (AI calls via @mariozechner/pi-ai)
# Change OPENROUTER_DEFAULT_MODEL value only — no code changes needed
# Examples: anthropic/claude-sonnet-4-5  anthropic/claude-opus-4  google/gemini-2.5-pro
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=anthropic/claude-sonnet-4-5
# Alpaca (news + price data)
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Exa.ai (semantic web search)
EXA_API_KEY=
# Random URL token for the Exa monitor webhook route — generate with: openssl rand -hex 16
EXA_WEBHOOK_TOKEN=
# Clerk (auth + billing). Keys: dashboard.clerk.com → API keys. Webhook signing secret:
# Clerk → Webhooks → your endpoint. PUBLIC_CLERK_PUBLISHABLE_KEY is public (not a secret).
CLERK_SECRET_KEY=
PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
# Email (Cloudflare Email Sending — [[send_email]] binding in wrangler.toml)
EMAIL_FROM_DOMAIN=
# App
PUBLIC_BASE_URL=
# Optional dev-only trigger for CompanyMonitor /tick (acceptance runs). NEVER set in prod.
DEV_AUTH_BYPASS=
